//# Syntax Showcase — external structured data.
//#
//# The path may also come from a variable: `with json(@data_file) as …`.
//# A missing file is a warning in editors and `mdt check`, and an error
//# for `mdt build`.
//#
//# Loads data/epics_cfg.json and unrolls one signal entry per member of
//# the "signals" object. Relative paths resolve against the directory
//# of the file containing the `with` block.
//#
//# Supported formats: json, csv. JSON mapping: object → dict, array →
//# list, number → int/float, string → string, bool → bool, null → omitted.
#package Showcase

+RTApp = {
  Class = RealTimeApplication
  Data = {
    Class = ReferenceContainer
    //! allow(unused): entries are consumed by the runtime, not in this file.
    with json("data/epics_cfg.json") as epics_cfg begin
      +EpicsSignals = {
        Class = EPICSCAInput
        Signals = {
          //# Two-variable foreach over a dict binds key and value.
          #foreach name, object in @epics_cfg.signals
            @name = {
              Type = @object.Type
              PVName = @object.PVName
            }
          #end
        }
      }
    end
    DefaultDataSource = DDB
    DDB = {
      Class = GAMDataSource
      Signals = {
        T: uint32
        Data: float64
      }
    }
    Timing = {
      Class = TimingDataSource
    }
  }
  Functions = {
    Class = ReferenceContainer
    GAM = {
      Class = IOGAM
      InputSignals = {
        EpicsSignals::Stat
      }
      OutputSignals = {
        DDB::T
      }
    }
  }
  States = {
    Class = ReferenceContainer
  }
  Scheduler = {
    Class = GAMScheduler
    TimingDataSource = Timing
  }
}
