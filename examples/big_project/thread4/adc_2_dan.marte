  +PulseDetector = {
    Class = PulseDetectorGAM
    UpperLimit = 2.40
    LowerLimit = 0.03
    InputSignals = {
      GY_MHV_V_MEAS_PSU = {
        DataSource = DDB4
        Type = float32
      }
    }
    OutputSignals = {
      MHVPS_PULSE_ON = {
        DataSource = DDB4
        Type = uint8
      }
    }
  } 
  +ComputeDANTrigger = {
    Class = JAConditionalSignalUpdateGAM
    Operation = "OR"
    LatchOutput = 0
    InputSignals = {
      TRIGGER_DAN_ONPULSE = {
        DataSource = Th1Bridge
        Comparator = "GREATER"
        Type = uint8
        Value = 0
      }
      TRIGGER_DAN = {
        DataSource = EPICSCAInput
        Comparator = "GREATER"
        Type = uint8
        Value = 0
      }
      MHVPS_PULSE_ON = {
        DataSource = DDB4
        Comparator = "GREATER"
        Type = uint8
        Value = 0
      }

    }
    OutputSignals = {
      TRIGGER_DAN = {
        DataSource = DDB4
        DefaultValue = 0
        Type = uint8
        Value = 1
      }
    }
  }
