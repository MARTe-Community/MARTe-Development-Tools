  #if @udp_streamer
    +UdpAnalogDataSource = {
      Class = IOExt::UDPStreamer
      MulticastGroup = "239.0.197.80"
      Interface = @UDP_IFACE
      Port = 44600 
      MaxPayloadSize = 8972 
      Signals = {
        Time = {
          Type = uint64
        }
        APS_V_Meas = {
          Type = float32
          NumberOfDimensions = 1
          NumberOfElements = @samples_adc
          TimeMode = "LastSample"
          TimeSignal = Time
          SamplingRate = @sampling_freq
          Unit = "V"
        }
        BPS_V_Meas = {
          Type = float32
          NumberOfDimensions = 1
          NumberOfElements = @samples_adc
          TimeMode = "LastSample"
          TimeSignal = Time
          SamplingRate = @sampling_freq
          Unit = "V"
        }
        MHV_V_Meas = {
          Type = float32
          NumberOfDimensions = 1
          NumberOfElements = @samples_adc
          TimeMode = "LastSample"
          TimeSignal = Time
          SamplingRate = @sampling_freq
          Unit = "V"
        }
        MHV_I_Meas = {
          Type = float32
          NumberOfDimensions = 1
          NumberOfElements = @samples_adc
          TimeMode = "LastSample"
          TimeSignal = Time
          SamplingRate = @sampling_freq
          Unit = "V"
        }
        Emitter_V_Meas = {
          Type = float32
          NumberOfDimensions = 1
          NumberOfElements = @samples_adc
          TimeMode = "LastSample"
          TimeSignal = Time
          SamplingRate = @sampling_freq
          Unit = "V"
        }
        Collector_I_Meas = {
          Type = float32
          NumberOfDimensions = 1
          NumberOfElements = @samples_adc
          TimeMode = "LastSample"
          TimeSignal = Time
          SamplingRate = @sampling_freq
          Unit = "V"
        }
      }
    }
  #end
  +FastAnalogDAN = {
    Class = DAN::DANSource
    NumberOfBuffers = 100
    CPUMask = @cpus_fdan
    StackSize = 10000000
    DanBufferMultiplier = @adc_dan_mul
    StoreOnTrigger = 1
    ICProgName = @app_name
    NumberOfPreTriggers = 0
    NumberOfPostTriggers = 0
    Signals = {
      Trigger = {
        Type = uint8
      }
      AI_Time = {
        Type = uint64
        TimeSignal = 1
        AbsoluteTime = 1
        TimeSignalMultiplier = 1e-9
        TimeSignalOffset = (-37 - @adc_cycle_time)
      }
      GY_APS_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
        SamplingFrequency = @sampling_freq
        NodeName = (@rfid .. ":GY_APS_V_MEAS")
      }
      GY_APS_I_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
        SamplingFrequency = @sampling_freq
        NodeName = (@rfid .. ":GY_APS_I_MEAS")
      }
      GY_BPS_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
        SamplingFrequency = @sampling_freq
        NodeName = (@rfid .. ":GY_BPS_V_MEAS")
      }
      GY_BPS_I_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
        SamplingFrequency = @sampling_freq
        NodeName = (@rfid .. ":GY_BPS_I_MEAS")
      }
      GY_MHV_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
        SamplingFrequency = @sampling_freq
        NodeName = (@rfid .. ":GY_MHV_V_MEAS")
      }
      GY_MHV_I_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
        SamplingFrequency = @sampling_freq
        NodeName = (@rfid .. ":GY_MHV_I_MEAS")
      }
      GY_ARC1_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
        SamplingFrequency = @sampling_freq
        NodeName = (@rfid .. ":GY_ARC1_V_MEAS")
      }
      GY_ARC2_V_MEAS = {
