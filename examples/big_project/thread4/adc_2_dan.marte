      }
      GY_ARC3_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
        SamplingFrequency = @sampling_freq
        NodeName = (@rfid .. ":GY_ARC3_V_MEAS")
      }
      GY_RF_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
        SamplingFrequency = @sampling_freq
        NodeName = (@rfid .. ":GY_RF_V_MEAS")
      }
      GY_MHV_V_MEAS_PSU = {
        Type = float32
        NumberOfElements = @samples_adc
        SamplingFrequency = @sampling_freq
        NodeName = (@rfid .. ":GY_MHV_V_MEAS_PSU")
      }
      GY_MHV_I_MEAS_PSU = {
        Type = float32
