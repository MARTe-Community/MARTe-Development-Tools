+EPICSCAOutput = {
  Class = EPICSCAOutput
  CPUMask = @cpus_epics // change from 0x200
  StackSize = 10000000
  NumberOfBuffers = 50
  CyclePeriod = @epics_slow_ratio
  Signals = {
    PCF_STATE = {
      PVName = (@rfid .. "-GAF:STAT-SM")
      Type = uint32
    }
    // Analog Output PVs in Variables-signal tab.
