+EPICSThSyncGAM = {
  Class = IOGAM
  InputSignals = {
    BPS_OUT = {
      DataSource = DDB1
    }
    APS_OUT = {
      DataSource = DDB1
    }
    MHVPS_OUT = {
      DataSource = DDB1
    }
    PLC_STANDBY = {
      DataSource = DDB1
    }
    FHPS_A_PrePro = {
      DataSource = DDB1
    }
    MCPS_RU_COMPLETED = {
     DataSource = EPICSCAInput 
    }
    MCPS_RD_COMPLETED = {
     DataSource = EPICSCAInput 
    }
    CCPS_IN_OPERATION = {
     DataSource = EPICSCAInput 
    }
  }
  OutputSignals = {
    BPS_OUT = {
      DataSource = Th1Bridge
    }
    APS_OUT = {
      DataSource = Th1Bridge
    }
    MHVPS_OUT = {
      DataSource = Th1Bridge
    }
    PLC_STANDBY = {
      DataSource = Th1Bridge
    }
    FHPS_A_PrePro = {
      DataSource = Th1Bridge
    }
    MCPS_RU_COMPLETED = {
      DataSource = Th1Bridge
    }
    MCPS_RD_COMPLETED = {
      DataSource = Th1Bridge
    }
    CCPS_IN_OPERATION = {
      DataSource = Th1Bridge
    }
  }
