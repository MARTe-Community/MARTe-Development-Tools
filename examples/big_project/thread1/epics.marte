    Th1Bridge::PCF_FAULT: uint8 as PCF_FAULT_Sync
    EPICSCAOutput::PXI_FLT: uint8
    Th1Bridge::PXI_FAULT: uint8 as PXI_FAULT_Sync
    EPICSCAOutput::BEAM_ON_STAT: uint8
    EPICSCAOutput::SHOT_ID: uint32
    EPICSCAOutput::FHPS_AUTO_STAT: uint32
    EPICSCAOutput::APS_HVON: uint8
    EPICSCAOutput::APS_SWON: uint8
    EPICSCAOutput::BPS_HVON: uint8
    EPICSCAOutput::BPS_SWON: uint8
    EPICSCAOutput::MHVPS_HVON: uint8
    EPICSCAOutput::EXT_TRIGGER: uint8
    EPICSCAOutput::ECPC_MHVPS_MOD: uint8
    EPICSCAOutput::PLC_PERMIT: uint8
    EPICSCAOutput::PLC_OP_SELECTED: uint8
    EPICSCAOutput::CCPS_IN_OP: uint8
    EPICSCAOutput::PLC_SYNCMODE: uint8
    EPICSCAOutput::PLC_ITL: uint8
    EPICSCAOutput::PLC_STANDBY: uint8
    EPICSCAOutput::PLC_READY: uint8
    EPICSCAOutput::PLC_ON: uint8
    EPICSCAOutput::APS_FLT: uint8
    EPICSCAOutput::APS_READY: uint8
    EPICSCAOutput::BPS_FLT: uint8
    EPICSCAOutput::BPS_READY: uint8
    EPICSCAOutput::MHPS_FLT: uint8
    EPICSCAOutput::MHPS_READY: uint8
    EPICSCAOutput::MHPS_OC: uint8
    EPICSCAOutput::MHPS_OV: uint8
    EPICSCAOutput::CRIO_RV1: uint8
    EPICSCAOutput::CRIO_RV2: uint8
    EPICSCAOutput::CRIO_RV3: uint8
    EPICSCAOutput::FAST_ITL: uint8
    // FAST_PAUSE
    EPICSCAOutput::PXI_6259_STATE: uint32
    EPICSCAOutput::PXI_6683_STATE: uint8
    EPICSCAOutput::PXI_6683_SYNC: uint8
    // PXI_6683_SYNCLOST 
    EPICSCAOutput::PXI_6528_STATE: uint32
    EPICSCAOutput::PulseStartTimeL: uint32
    EPICSCAOutput::PulseStartTimeH: uint32
    EPICSCAOutput::PulseStopTimeL: uint32
    EPICSCAOutput::PulseStopTimeH: uint32
  }
