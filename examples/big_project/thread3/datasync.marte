  +AsyncIOGAM = {
    Class = IOGAM
    InputSignals = {
      FHPS_A_RU = {
        DataSource = WGAsyncBridge
      }
      CCPS_IN_OPERATION = {
        DataSource = Th1Bridge
      }
      MCPS_RU_COMPLETED = {
        DataSource = Th1Bridge
      }
      MCPS_RD_COMPLETED = {
        DataSource = Th1Bridge
      }
    }
    OutputSignals = {
      FHPS_RU = {
        DataSource = DDB3
      }
      CCPS_IN_OPERATION = {
        DataSource = DDB3
      }   
      SCM_RU = {
        DataSource = DDB3
      }
      SCM_RD = {
        DataSource = DDB3
      }
