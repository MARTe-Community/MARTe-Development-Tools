+Error = {
  Class = RealTimeState
  +Threads = {
    Class = ReferenceContainer
    +EPICSThread = {
      Class = RealTimeThread
      Functions = {
        SyncThreadConsumerGAM,
        DecimateGAM,
        StateGAM,
        PXIErrorGAM,
        ResetErrorGAM,
        ChoiceGAM,
        ReferencesConditioning,
        EPICSThSyncGAM,
        EPICSOutputGAM
      }
      // REMOVED: GoErrorGAM (redundant), FHPSSetPointGAM and FHPSRumpUpGAM
      // TODO: Discus about the removal
      CPUs = @cpus_epics
    }
    #if @sdn_enabled
      +SDNThread = {
        Class = RealTimeThread
        Functions = {
          TimeSDNGAM,
          SDNCommandGAM,
          SDNReplyGAM
        }
        CPUs = @cpus_sdn
      }
    #end
    +RealTimeThread = {
