    +ADCThread = {
      Class = RealTimeThread
      CPUs = @cpus_adc
      Functions = {
        ReadADC,
        AdcTimeStamp,
        PulseDetector,
        ComputeDANTrigger,
        PushADCtoDAN,
        PushADCtoEpics,
        #if @udp_streamer
          PushADCtoUDP
        #end
      }
    }
    +DANThread = {
      Class = RealTimeThread
      CPUs = @cpus_dan
      Functions = {
        WaitForDioSignals,
        DANDIOPublisherGAM,
        #if @udp_streamer
          UdpDIOPublisherGAM
        #end
      }
    }
    +ReferenceGenerationThread = {
      Class = RealTimeThread
      CPUs = @cpus_wg
      Functions = @wg_functions
    }
  }
}
// Real-Time state for HVPS sequence timing control.
