        NI6528_0_ReaderGAM,
        AsyncIOGAM,
        HVPSsOffGAM,
        StoreStartPulseTime,
        StoreStopPulseTime,
        NI6528_0_WriterGAM,
        SyncThreadProducerGAM
      }
      CPUs = @cpus_rt
    }
    +ADCThread = {
      Class = RealTimeThread
      CPUs = @cpus_adc
      Functions = {
        ReadADC,
        AdcTimeStamp,
        PulseDetector,
        ComputeDANTrigger,
        PushADCtoDAN,
        PushADCtoEpics,
        #if @udp_streamer
          PushADCtoUDP
        #end
      }
    }
    +DANThread = {
      Class = RealTimeThread
      CPUs = @cpus_dan
      Functions = {
        WaitForDioSignals,
        DANDIOPublisherGAM,
        #if @udp_streamer
          UdpDIOPublisherGAM
        #end
      }
    }
    +ReferenceGenerationThread = {
      Class = RealTimeThread
      CPUs = @cpus_wg
      Functions = {
        WGTimerGAM,
        CCPSWaveformGAM,
        FHPS_A_StateGAM,
        FHPS_A_GainGAM,
        FHPS_B_StateGAM,
        FHPS_B_GainGAM,
        WGProducerGAM
      }
    }
  }
}
