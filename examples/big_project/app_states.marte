#package jada_gyro.RTApp.States

#let wg_functions: [&GAM] = {
  WGTimerGAM,
  CCPSWaveformGAM,
  FHPS_A_SetpointGAM,
  FHPS_A_RampupGAM,
  FHPS_A_StateGAM,
  FHPS_A_GainGAM,
  FHPS_B_SetpointGAM,
  FHPS_B_RampupGAM,
  FHPS_B_StateGAM,
  FHPS_B_GainGAM,
  WGProducerGAM
}

#let adc_thread: [&GAM] = {
  ReadADC,
  AbsoluteTimeGenerator,
  PulseDetector,
  ComputeDANTrigger,
  PushADCtoDAN,
  #if @udp_streamer
    PushADCtoUDP,
  #end
  PushADCtoEpics,
}

+Disabled = {
  Class = RealTimeState
  +Threads = {
    Class = ReferenceContainer
    +EPICSThread = {
      Class = RealTimeThread
      CPUs = @cpus_epics
      Functions = {
        SyncThreadConsumerGAM,
        DecimateGAM,
        StateGAM,
        MCPSGAM,
        PXIErrorGAM,
        GoErrorGAM,
        GoWaitStandbyGAM,
        ChoiceGAM,
        ReferencesConditioning,
        EPICSThSyncGAM,
        EPICSOutputGAM
      }
    }
    #if @sdn_enabled
      +SDNThread = {
        Class = RealTimeThread
        CPUs = @cpus_sdn
        Functions = {
          TimeSDNGAM,
          SDNCommandGAM,
          SDNReplyGAM
        }
      }
    #end
    +RealTimeThread = {
      Class = RealTimeThread
      CPUs = @cpus_rt
      Functions = {
        FastTimerGAM,
        NI6528_0_ReaderGAM,
        AsyncIOGAM,
        HVPSsOffGAM,
        StoreStartPulseTime,
        StoreStopPulseTime,
        NI6528_0_WriterGAM,
        SyncThreadProducerGAM
      }
    }
    +ADCThread = {
      Class = RealTimeThread
      CPUs = @cpus_adc
      Functions = {
        ReadADC,
        AdcTimeStamp,
        PulseDetector,
        ComputeDANTrigger,
        PushADCtoDAN,
        PushADCtoEpics,
        #if @udp_streamer
          PushADCtoUDP
        #end
      }
    }
    +DANThread = {
      Class = RealTimeThread
      CPUs = @cpus_dan
      Functions = {
        WaitForDioSignals,
        DANDIOPublisherGAM,
        #if @udp_streamer
          UdpDIOPublisherGAM
        #end
      }
    }
    +ReferenceGenerationThread = {
      Class = RealTimeThread
      CPUs = @cpus_wg
      Functions = {
        WGTimerGAM,
        CCPSWaveformGAM,
        FHPS_A_StateGAM,
        FHPS_A_GainGAM,
        FHPS_B_StateGAM,
        FHPS_B_GainGAM,
        WGProducerGAM
      }
    }
  }
}
+WaitStandby = {
  Class = RealTimeState
  +Threads = {
    Class = ReferenceContainer
    +EPICSThread = {
      Class = RealTimeThread
      Functions = {
        SyncThreadConsumerGAM,
        DecimateGAM,
        StateGAM,
        MCPSGAM,
        PXIErrorGAM,
        GoDisabledGAM,
        GoWaitReadyGAM,
        GoErrorGAM,
        ChoiceGAM,
        ReferencesConditioning,
        EPICSThSyncGAM,
        EPICSOutputGAM
      }
      CPUs = @cpus_epics
    }
    #if @sdn_enabled
      +SDNThread = {
        Class = RealTimeThread
        Functions = {
          TimeSDNGAM,
          SDNCommandGAM,
          SDNReplyGAM
        }
        CPUs = @cpus_sdn
      }
    #end
    +RealTimeThread = {
      Class = RealTimeThread
      Functions = {
        FastTimerGAM,
        NI6528_0_ReaderGAM,
        AsyncIOGAM,
        HVPSsOffGAM,
        StoreStartPulseTime,
        StoreStopPulseTime,
        NI6528_0_WriterGAM,
        SyncThreadProducerGAM
      }
      CPUs = @cpus_rt
    }
    +ADCThread = {
      Class = RealTimeThread
      CPUs = @cpus_adc
      Functions = {
        ReadADC,
        AdcTimeStamp,
        PulseDetector,
        ComputeDANTrigger,
        PushADCtoDAN,
        PushADCtoEpics,
        #if @udp_streamer
          PushADCtoUDP
        #end
      }
    }
    +DANThread = {
      Class = RealTimeThread
      CPUs = @cpus_dan
      Functions = {
        WaitForDioSignals,
        DANDIOPublisherGAM,
        #if @udp_streamer
          UdpDIOPublisherGAM
        #end
      }
    }
    +ReferenceGenerationThread = {
      Class = RealTimeThread
      CPUs = @cpus_wg
      Functions = @wg_functions
    }
  }
}
+WaitReady = {
  Class = RealTimeState
  +Threads = {
    Class = ReferenceContainer
    +EPICSThread = {
      Class = RealTimeThread
      Functions = {
        SyncThreadConsumerGAM,
        DecimateGAM,
        StateGAM,
        WFRecordGAM,
        PreProgrammedGAM,
        PXIErrorGAM,
        GoWaitPermitGAM,
        GoWaitStandbyFromReadyGAM,
        GoErrorGAM,
        ChoiceGAM,
        ReferencesConditioning,
        EPICSThSyncGAM,
        EPICSOutputGAM
      }
      CPUs = @cpus_epics
    }
    #if @sdn_enabled
      +SDNThread = {
        Class = RealTimeThread
        Functions = {
          TimeSDNGAM,
          SDNCommandGAM,
          SDNReplyGAM
        }
        CPUs = @cpus_sdn
      }
    #end
    +RealTimeThread = {
      Class = RealTimeThread
      Functions = {
        FastTimerGAM,
        NI6528_0_ReaderGAM,
        AsyncIOGAM,
        HVPSsOffGAM,
        StoreStartPulseTime,
        StoreStopPulseTime,
        NI6528_0_WriterGAM,
        SyncThreadProducerGAM
      }
      CPUs = @cpus_rt
    }
    +ADCThread = {
      Class = RealTimeThread
      CPUs = @cpus_adc
      #if @udp_streamer
        Functions = {
          ReadADC,
          AdcTimeStamp,
          PulseDetector,
          ComputeDANTrigger,
          PushADCtoDAN,
          PushADCtoEpics,
          PushADCtoUDP
        }
      #else
        Functions = {
          ReadADC,
          AdcTimeStamp,
          PulseDetector,
          ComputeDANTrigger,
          PushADCtoDAN,
          PushADCtoEpics
        }
      #end
    }
    +DANThread = {
      Class = RealTimeThread
      CPUs = @cpus_dan
      Functions = {
        WaitForDioSignals,
        DANDIOPublisherGAM,
        #if @udp_streamer
          UdpDIOPublisherGAM
        #end
      }
    }
    +ReferenceGenerationThread = {
      Class = RealTimeThread
      CPUs = @cpus_wg
      Functions = @wg_functions
    }
  }
}
+WaitPermit = {
  Class = RealTimeState
  +Threads = {
    Class = ReferenceContainer
    +EPICSThread = {
      Class = RealTimeThread
      Functions = {
        SyncThreadConsumerGAM,
        DecimateGAM,
        StateGAM,
        WFRecordGAM,
