#package jada_gyro.RTApp.Functions

//! allow(implicit)  // the original IOGAM annotated two implicit signals

//# Copy data from DDB1 to EPICSCAOutput DataSource.
copy EPICSOutputGAM {
  DDB1::PCF_STATE { Type = uint32 } -> EPICSCAOutput::PCF_STATE { Type = uint32 }
  DDB1::MCPS_ACT_SP { Type = uint32  Value = 0 } -> EPICSCAOutput::MCPS_ACT_SP { Type = uint32 }
  DDB1::GCPS_ACT_SP { Type = uint32  Value = 0 } -> EPICSCAOutput::GCPS_ACT_SP { Type = uint32 }
  DDB1::BPS_OUT -> EPICSCAOutput::BPS_REF { Type = float32 }
  DDB1::APS_OUT -> EPICSCAOutput::APS_REF { Type = float32 }
  DDB1::MCPS_OUT -> EPICSCAOutput::MCPS_TRG_CURR_SET { Type = float32 }
  DDB1::GCPS_OUT -> EPICSCAOutput::GCPS_TRG_CURR_SET { Type = float32 }
  WGAsyncBridge::FHPS_A_REF { Type = float32 } -> EPICSCAOutput::FHPS_REF { Type = float32 }
  DDB1::CSV_LOADED { Type = uint32 } -> EPICSCAOutput::CSV_LOADED { Type = uint32 }
  DDB1::CSV_ERR { Type = uint32 } -> EPICSCAOutput::CSV_ERR { Type = uint32 }
  DDB1::ELAPSED_TIME { Type = uint32 } -> EPICSCAOutput::ELAPSED_TIME { Type = uint32 }
  DDB1::HVARMED { Type = uint8 } -> EPICSCAOutput::HVARMED { Type = uint8 }
  DDB1::HVINJECTION { Type = uint8 } -> EPICSCAOutput::HVINJECTION { Type = uint8 }
  DDB1::RFON { Type = uint8 } -> EPICSCAOutput::RFON { Type = uint8 }
  DDB1::MHVPS_OUT { Type = float32 } -> EPICSCAOutput::MHVPS_REF { Type = float32 }
  DDB1::PREP_TIME_WF { Type = int32  NumberOfElements = 8000 } -> EPICSCAOutput::PREP_TIME_WF { Type = int32  NumberOfElements = 8000 }
  DDB1::MHVPS_PREP_WF { Type = float32  NumberOfElements = 8000 } -> EPICSCAOutput::MHVPS_PREP_WF { Type = float32  NumberOfElements = 8000 }
  DDB1::BPS_PREP_WF { Type = float32  NumberOfElements = 8000 } -> EPICSCAOutput::BPS_PREP_WF { Type = float32  NumberOfElements = 8000 }
  DDB1::APS_PREP_WF { Type = float32  NumberOfElements = 8000 } -> EPICSCAOutput::APS_PREP_WF { Type = float32  NumberOfElements = 8000 }
  DDB1::MCPS_PREP_WF { Type = float32  NumberOfElements = 8000 } -> EPICSCAOutput::MCPS_PREP_WF { Type = float32  NumberOfElements = 8000 }
  DDB1::GCPS_PREP_WF { Type = float32  NumberOfElements = 8000 } -> EPICSCAOutput::GCPS_PREP_WF { Type = float32  NumberOfElements = 8000 }
  DDB1::FHPS_A_PREP_WF { Type = float32  NumberOfElements = 8000 } -> EPICSCAOutput::FHPS_PREP_WF { Type = float32  NumberOfElements = 8000 }
  WGAsyncBridge::CCPS_REF { Type = float32 } -> EPICSCAOutput::CCPS_REF { Type = float32 }
  DDB1::FAST_STOP as MHVPS_STOP { Type = uint32 } -> EPICSCAOutput::MHVPS_STOP { Type = uint32 }
  DDB1::FAST_STOP as APS_STOP { Type = uint32 } -> EPICSCAOutput::APS_STOP { Type = uint32 }
  DDB1::FAST_STOP as BPS_STOP { Type = uint32 } -> EPICSCAOutput::BPS_STOP { Type = uint32 }
  DDB1::BEAM_ON_TIME { Type = uint32 } -> EPICSCAOutput::BEAM_ON_TIME { Type = uint32 }
  DDB1::PCF_FAULT { Type = uint8 } -> EPICSCAOutput::PCF_FLT { Type = uint8 }
  DDB1::PCF_FAULT as PCF_FAULT_Sync { Type = uint8 } -> Th1Bridge::PCF_FAULT as PCF_FAULT_Sync { Type = uint8 }
  DDB1::PXI_FAULT { Type = uint8 } -> EPICSCAOutput::PXI_FLT { Type = uint8 }
  DDB1::PXI_FAULT as PXI_FAULT_Sync { Type = uint8 } -> Th1Bridge::PXI_FAULT as PXI_FAULT_Sync { Type = uint8 }
  DDB1::BEAM_ON_STAT { Type = uint8 } -> EPICSCAOutput::BEAM_ON_STAT { Type = uint8 }
  DDB1::SHOT_ID { Type = uint32 } -> EPICSCAOutput::SHOT_ID { Type = uint32 }
  WGAsyncBridge::FHPS_A_AUTO_STAT { Type = uint32 } -> EPICSCAOutput::FHPS_AUTO_STAT { Type = uint32 }
  DDB1::APS_HVON { Type = uint8 } -> EPICSCAOutput::APS_HVON { Type = uint8 }
  DDB1::APS_SWON { Type = uint8 } -> EPICSCAOutput::APS_SWON { Type = uint8 }
  DDB1::BPS_HVON { Type = uint8 } -> EPICSCAOutput::BPS_HVON { Type = uint8 }
  DDB1::BPS_SWON { Type = uint8 } -> EPICSCAOutput::BPS_SWON { Type = uint8 }
  DDB1::MHVPS_HVON { Type = uint8 } -> EPICSCAOutput::MHVPS_HVON { Type = uint8 }
  DDB1::TRIGGER { Type = uint8 } -> EPICSCAOutput::EXT_TRIGGER { Type = uint8 }
  DDB1::ECPC_MOD { Type = uint8 } -> EPICSCAOutput::ECPC_MHVPS_MOD { Type = uint8 }
  DDB1::PLC_PERMIT { Type = uint8 } -> EPICSCAOutput::PLC_PERMIT { Type = uint8 }
  DDB1::PLC_OP_SELECTED { Type = uint8 } -> EPICSCAOutput::PLC_OP_SELECTED { Type = uint8 }
  DDB1::PLC_CC_OP_SELECTED { Type = uint8 } -> EPICSCAOutput::CCPS_IN_OP { Type = uint8 }
  DDB1::PLC_SYNCMODE { Type = uint8 } -> EPICSCAOutput::PLC_SYNCMODE { Type = uint8 }
  DDB1::PLC_ITL { Type = uint8 } -> EPICSCAOutput::PLC_ITL { Type = uint8 }
  DDB1::PLC_STANDBY { Type = uint8 } -> EPICSCAOutput::PLC_STANDBY { Type = uint8 }
  DDB1::PLC_READY { Type = uint8 } -> EPICSCAOutput::PLC_READY { Type = uint8 }
  DDB1::PLC_ON { Type = uint8 } -> EPICSCAOutput::PLC_ON { Type = uint8 }
  DDB1::GYA_APS_FLT { Type = uint8 } -> EPICSCAOutput::APS_FLT { Type = uint8 }
  DDB1::GYA_APS_READY { Type = uint8 } -> EPICSCAOutput::APS_READY { Type = uint8 }
  DDB1::GYA_BPS_FLT { Type = uint8 } -> EPICSCAOutput::BPS_FLT { Type = uint8 }
  DDB1::GYA_BPS_READY { Type = uint8 } -> EPICSCAOutput::BPS_READY { Type = uint8 }
  DDB1::MHVPS_FLT { Type = uint8 } -> EPICSCAOutput::MHPS_FLT { Type = uint8 }
  DDB1::MHVPS_READY { Type = uint8 } -> EPICSCAOutput::MHPS_READY { Type = uint8 }
  DDB1::MHVPS_OC { Type = uint8 } -> EPICSCAOutput::MHPS_OC { Type = uint8 }
  DDB1::MHVPS_OV { Type = uint8 } -> EPICSCAOutput::MHPS_OV { Type = uint8 }
  DDB1::CRIO_RV1 { Type = uint8 } -> EPICSCAOutput::CRIO_RV1 { Type = uint8 }
  DDB1::CRIO_RV2 { Type = uint8 } -> EPICSCAOutput::CRIO_RV2 { Type = uint8 }
  DDB1::CRIO_RV3 { Type = uint8 } -> EPICSCAOutput::CRIO_RV3 { Type = uint8 }
  DDB1::FAST_TRIP { Type = uint8 } -> EPICSCAOutput::FAST_ITL { Type = uint8 }
  DDB1::PXI6259_Status { Type = uint32 } -> EPICSCAOutput::PXI_6259_STATE { Type = uint32 }
  DDB1::PXI6683_Status { Type = uint8 } -> EPICSCAOutput::PXI_6683_STATE { Type = uint8 }
  DDB1::PXI6683_PtpdStatus { Type = uint8 } -> EPICSCAOutput::PXI_6683_SYNC { Type = uint8 }
  DDB1::PXI6528_Status { Type = uint32 } -> EPICSCAOutput::PXI_6528_STATE { Type = uint32 }
  DDB1::PulseStartTime { Type = uint64 } -> (EPICSCAOutput::PulseStartTimeL { Type = uint32 }, EPICSCAOutput::PulseStartTimeH { Type = uint32 })
  DDB1::PulseStopTime { Type = uint64 } -> (EPICSCAOutput::PulseStopTimeL { Type = uint32 }, EPICSCAOutput::PulseStopTimeH { Type = uint32 })
}
