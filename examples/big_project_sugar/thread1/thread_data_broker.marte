#package jada_gyro.RTApp.Functions


//# Synchronise Thread 1 to Thread 3 using SynchTread data source
//# Thread 1 will be executed every @fast_slow_ratio cycles of Thread 3
copy SyncThreadConsumerGAM {
  SynchThread::PXI6259_Status { Samples = @fast_slow_ratio  Frequency = 1 } -> DDB1::PXI6259_Status_SAMPLES
  SynchThread::PXI6528_Status { Samples = @fast_slow_ratio } -> DDB1::PXI6528_Status_SAMPLES
  SynchThread::PXI6683_Status { Samples = @fast_slow_ratio } -> DDB1::PXI6683_Status_SAMPLES
  SynchThread::PXI6683_PtpdStatus { Samples = @fast_slow_ratio } -> DDB1::PXI6683_PtpdStatus_SAMPLES
  SynchThread::GYA_APS_READY { Samples = @fast_slow_ratio } -> DDB1::GYA_APS_READY_SAMPLES
  SynchThread::GYA_APS_FLT { Samples = @fast_slow_ratio } -> DDB1::GYA_APS_FLT_SAMPLES
  SynchThread::GYA_BPS_READY { Samples = @fast_slow_ratio } -> DDB1::GYA_BPS_READY_SAMPLES
  SynchThread::GYA_BPS_FLT { Samples = @fast_slow_ratio } -> DDB1::GYA_BPS_FLT_SAMPLES
  SynchThread::MHVPS_OV { Samples = @fast_slow_ratio } -> DDB1::MHVPS_OV_SAMPLES
  SynchThread::MHVPS_OC { Samples = @fast_slow_ratio } -> DDB1::MHVPS_OC_SAMPLES
  SynchThread::MHVPS_FLT { Samples = @fast_slow_ratio } -> DDB1::MHVPS_FLT_SAMPLES
  SynchThread::MHVPS_READY { Samples = @fast_slow_ratio } -> DDB1::MHVPS_READY_SAMPLES
  SynchThread::ECPC_MOD { Samples = @fast_slow_ratio } -> DDB1::ECPC_MOD_SAMPLES
  SynchThread::FAST_TRIP { Samples = @fast_slow_ratio } -> DDB1::FAST_TRIP_SAMPLES
  SynchThread::PLC_ITL { Samples = @fast_slow_ratio } -> DDB1::PLC_ITL_SAMPLES
  SynchThread::PLC_STANDBY { Samples = @fast_slow_ratio } -> DDB1::PLC_STANDBY_SAMPLES
  SynchThread::PLC_READY { Samples = @fast_slow_ratio } -> DDB1::PLC_READY_SAMPLES
  SynchThread::PLC_ON { Samples = @fast_slow_ratio } -> DDB1::PLC_ON_SAMPLES
  SynchThread::PLC_PERMIT { Samples = @fast_slow_ratio } -> DDB1::PLC_PERMIT_SAMPLES
  SynchThread::PLC_OP_SELECTED { Samples = @fast_slow_ratio } -> DDB1::PLC_OP_SELECTED_SAMPLES
  SynchThread::PLC_CC_OP_SELECTED { Samples = @fast_slow_ratio } -> DDB1::PLC_CC_OP_SELECTED_SAMPLES
  SynchThread::PLC_SYNCMODE { Samples = @fast_slow_ratio } -> DDB1::PLC_SYNCMODE_SAMPLES
  SynchThread::TRIGGER { Samples = @fast_slow_ratio } -> DDB1::TRIGGER_SAMPLES
  SynchThread::BEAM_ON_STAT { Samples = @fast_slow_ratio } -> DDB1::BEAM_ON_STAT_SAMPLES
  SynchThread::HVARMED { Samples = @fast_slow_ratio } -> DDB1::HVARMED_SAMPLES
  SynchThread::HVINJECTION { Samples = @fast_slow_ratio } -> DDB1::HVINJECTION_SAMPLES
  SynchThread::RFON { Samples = @fast_slow_ratio } -> DDB1::RFON_SAMPLES
  SynchThread::BEAM_ON_TIME { Samples = @fast_slow_ratio } -> DDB1::ELAPSED_TIME_SAMPLES
  SynchThread::RFON_TIME { Samples = @fast_slow_ratio } -> DDB1::BEAM_ON_TIME_SAMPLES
  SynchThread::SHOT_ID { Samples = @fast_slow_ratio } -> DDB1::SHOT_ID_SAMPLES
  SynchThread::CRIO_RV1 { Samples = @fast_slow_ratio } -> DDB1::CRIO_RV1_SAMPLES
  SynchThread::CRIO_RV2 { Samples = @fast_slow_ratio } -> DDB1::CRIO_RV2_SAMPLES
  SynchThread::CRIO_RV3 { Samples = @fast_slow_ratio } -> DDB1::CRIO_RV3_SAMPLES
  SynchThread::PulseStartTime { Samples = @fast_slow_ratio } -> DDB1::PulseStartTime_SAMPLES
  SynchThread::PulseStopTime { Samples = @fast_slow_ratio } -> DDB1::PulseStopTime_SAMPLES
}

copy DecimateGAM {
  DDB1::PXI6259_Status_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PXI6259_Status
  DDB1::PXI6528_Status_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PXI6528_Status
  DDB1::PXI6683_Status_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PXI6683_Status
  DDB1::PXI6683_PtpdStatus_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PXI6683_PtpdStatus
  DDB1::GYA_APS_READY_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::GYA_APS_READY
  DDB1::GYA_APS_FLT_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::GYA_APS_FLT
  DDB1::GYA_BPS_READY_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::GYA_BPS_READY
  DDB1::GYA_BPS_FLT_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::GYA_BPS_FLT
  DDB1::MHVPS_OV_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::MHVPS_OV
  DDB1::MHVPS_OC_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::MHVPS_OC
  DDB1::MHVPS_FLT_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::MHVPS_FLT
  DDB1::MHVPS_READY_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::MHVPS_READY
  DDB1::ECPC_MOD_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::ECPC_MOD
  DDB1::FAST_TRIP_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::FAST_TRIP
  DDB1::PLC_ITL_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PLC_ITL
  DDB1::PLC_STANDBY_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PLC_STANDBY
  DDB1::PLC_READY_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PLC_READY
  DDB1::PLC_ON_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PLC_ON
  DDB1::PLC_PERMIT_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PLC_PERMIT
  DDB1::PLC_OP_SELECTED_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PLC_OP_SELECTED
  DDB1::PLC_CC_OP_SELECTED_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PLC_CC_OP_SELECTED
  DDB1::PLC_SYNCMODE_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PLC_SYNCMODE
  DDB1::TRIGGER_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::TRIGGER
  DDB1::BEAM_ON_STAT_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::BEAM_ON_STAT
  DDB1::HVARMED_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::HVARMED
  DDB1::HVINJECTION_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::HVINJECTION
  DDB1::RFON_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::RFON
  DDB1::ELAPSED_TIME_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::ELAPSED_TIME
  DDB1::BEAM_ON_TIME_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::BEAM_ON_TIME
  DDB1::SHOT_ID_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::SHOT_ID
  DDB1::CRIO_RV1_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::CRIO_RV1
  DDB1::CRIO_RV2_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::CRIO_RV2
  DDB1::CRIO_RV3_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::CRIO_RV3
  DDB1::PulseStartTime_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PulseStartTime
  DDB1::PulseStopTime_SAMPLES { Ranges = { { @dec_index, @dec_index } } } -> DDB1::PulseStopTime
  WGAsyncBridge::FHPS_A_RU -> DDB1::FHPS_A_RU
}

copy EPICSThSyncGAM {
  DDB1::BPS_OUT -> Th1Bridge::BPS_OUT
  DDB1::APS_OUT -> Th1Bridge::APS_OUT
  DDB1::MHVPS_OUT -> Th1Bridge::MHVPS_OUT
  DDB1::PLC_STANDBY -> Th1Bridge::PLC_STANDBY
  DDB1::FHPS_A_PrePro -> Th1Bridge::FHPS_A_PrePro
  EPICSCAInput::MCPS_RU_COMPLETED -> Th1Bridge::MCPS_RU_COMPLETED
  EPICSCAInput::MCPS_RD_COMPLETED -> Th1Bridge::MCPS_RD_COMPLETED
  EPICSCAInput::CCPS_IN_OPERATION -> Th1Bridge::CCPS_IN_OPERATION
}
