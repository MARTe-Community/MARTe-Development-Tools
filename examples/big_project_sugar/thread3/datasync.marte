+Functions = {
  copy SyncThreadProducerGAM {
    DDB3::AbsoluteTime -> SynchThread::DiTime
    NI6259_DIO_P0::Status as PXI6259_Status -> SynchThread::PXI6259_Status
    DDB3::PXI6528_Status { Value = 0 } -> SynchThread::PXI6528_Status
    TimingBoard::Status as PXI6683_Status -> SynchThread::PXI6683_Status
