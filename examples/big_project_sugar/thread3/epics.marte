#package jada_gyro.RTApp

+Functions = {
  //# Thread3 pulse parameter EPICS PVs read.
  //# TODO: Should be better to read it in thread 1 and use a async bridge to copy to 3?
  copy FastEpicsInputGAM {
    EPICSCAInput::MHVPS_DT { Type = uint32 } -> DDB3::MHVPS_DT
    EPICSCAInput::APS_HVON_DT { Type = uint32 } -> DDB3::APS_HVON_DT
    EPICSCAInput::APS_SWON_DT { Type = uint32 } -> DDB3::APS_SWON_DT
    EPICSCAInput::BPS_HVON_DT { Type = uint32 } -> DDB3::BPS_HVON_DT
    EPICSCAInput::BPS_SWON_DT { Type = uint32 } -> DDB3::BPS_SWON_DT
    EPICSCAInput::SHOTLEN { Type = uint32 } -> DDB3::SHOTLEN
    EPICSCAInput::SHORT_PULSE_MODE -> DDB3::SHORT_PULSE_MODE
    EPICSCAInput::FAST_PAUSE -> DDB3::FAST_PAUSE
  }
}
