      }
      GY_APS_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      GY_APS_I_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      GY_BPS_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      GY_BPS_I_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      GY_MHV_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      GY_MHV_I_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      GY_ARC1_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      GY_ARC2_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      GY_ARC3_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      GY_RF_V_MEAS = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      GY_MHV_V_MEAS_PSU = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      GY_MHV_I_MEAS_PSU = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      Channel_12 = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      Channel_13 = {
        Type = float32
        NumberOfElements = @samples_adc
      }
      Channel_14 = {
        Type = float32
