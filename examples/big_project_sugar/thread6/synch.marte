#package jada_gyro.RTApp

+Data = {
  +WGAsyncBridge = {
    Class = RealTimeThreadAsyncBridge
    NumberOfBuffers = 5
    Signals = {
      CCPS_REF = {
        Type = float32
      }
      FHPS_A_REF = {
        Type = float32
      }
      FHPS_A_AUTO_STAT = {
        Type = uint32
      }
      FHPS_A_RU = {
        Type = uint8
      }
      //# Not consumed right now
      FHPS_B_RU = {
        Type = uint8
      }
    }
  }
  +NI6259_AO = {
    Class = NI6259DAC
    DeviceName = "/dev/pxi6259" // Mandatory
    BoardId = 1 // Mandatory
    SamplingFrequency = @wg_clock
    Signals = {
      CCPS_REF = {
        Type = float32 // Mandatory. Only type that is supported.
        ChannelId = 0 // Mandatory. The channel number.
        OutputPolarity = "Bipolar" // Optional. Possible values: Bipolar, Unipolar. Default value Unipolar.
      }
      FHPS_A_REF = {
        Type = float32
        ChannelId = 1
        OutputPolarity = "Bipolar"
      }
      FHPS_B_REF = {
        Type = float32
        ChannelId = 2
        OutputPolarity = "Bipolar"
      }
    }
  }
  +NI6368_AO = {
    Class = "NI6368::NI6368DAC"
    DeviceName = "/dev/pxie-6368" // Mandatory
    BoardId = 0 // Mandatory
    IsMultiplexed = 0
    SamplingFrequency = @wg_clock
    Signals = {
      BPS_VREF = {
        Type = float32
        ChannelId = 0
        OutputRange = 10
        OutputGain = 0.25
      }
      APS_VREF = {
        Type = float32
        ChannelId = 1
        OutputRange = 10
      }
      MAIN_VREF = {
        Type = float32
        ChannelId = 2
        OutputRange = 10
      }
    }
  }
}
+Functions = {
  copy WGProducerGAM {
    DDB6::CCPS_REF -> WGAsyncBridge::CCPS_REF
    DDB6::CCPS_REF as CCPS_REF_OUT -> NI6259_AO::CCPS_REF as CCPS_REF_OUT
    DDB6::FHPS_A_SCALED -> NI6259_AO::FHPS_A_REF as FHPS_REF_A_OUT { Trigger = 1 }
    Th1Bridge::BPS_OUT as BPS_VREF { Type = float32 } -> NI6368_AO::BPS_VREF { Type = float32 }
    Th1Bridge::APS_OUT as APS_VREF { Type = float32 } -> NI6368_AO::APS_VREF { Type = float32 }
    Th1Bridge::MHVPS_OUT as MAIN_VREF { Type = float32 } -> NI6368_AO::MAIN_VREF { Type = float32  Trigger = 1 }
    DDB6::FHPS_A_REF as FHPS_A_REF_OUT -> WGAsyncBridge::FHPS_A_REF
    DDB6::FHPS_A_AUTO_STAT -> WGAsyncBridge::FHPS_A_AUTO_STAT
    DDB6::FHPS_B_SCALED -> NI6259_AO::FHPS_B_REF
  }
}
